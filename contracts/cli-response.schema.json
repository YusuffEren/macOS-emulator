{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tempera.local/schemas/android-sim-response-v1.json",
  "title": "android-sim response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "data", "warnings", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["ok", "error"]},
    "data": {},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"}
          }
        }
      ]
    }
  }
}
